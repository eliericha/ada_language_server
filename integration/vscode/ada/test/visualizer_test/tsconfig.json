{
    "extends": "../../tsconfig.json",
    "compilerOptions": {
        "module": "commonjs",
        "target": "ES2020",
        "outDir": "../../out",
        "lib": ["DOM", "ES2020"],
        "sourceMap": true,
        "declaration": true,
        "declarationMap": true,
        "removeComments": true,
        "moduleResolution": "node",
        "esModuleInterop": true,
        "resolveJsonModule": true,
        "skipLibCheck": true,
        "types": ["node", "@wdio/mocha-framework", "wdio-vscode-service", "@wdio/globals/types"],
        "experimentalDecorators": true
    },
    "include": ["helpers/*.ts", "./wdio.conf.ts", "specs/*.e2e.ts"],
    "exclude": []
}
